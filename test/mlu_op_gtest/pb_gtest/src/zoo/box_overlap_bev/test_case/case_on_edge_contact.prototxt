# Regression case for PYTORCH-29910: boxes whose vertices lie exactly on the
# other box's edge (on-edge contact). Pre-fix, float32 rounding randomly drops
# such vertices in the t in [0,1] / dot-product boundary tests and the overlap
# area collapses (4.0 -> 2.0 / 0.0). Rows below reproduce the Jira probe
# configs; all boxes are centered at the origin so every pair overlaps and the
# diagonal (i == j) is the original 6 repro pairs:
#   A0-B0 same heading, A contained in B with collinear edges      -> 4.0
#   A1-B1 perpendicular (+pi/2), heading 0.3                       -> 4.0
#   A2-B2 perpendicular (+pi/2), heading -0.7                      -> 4.0
#   A3-B3 perpendicular (+pi/2), heading 1.5                       -> 4.0
#   A4-B4 perpendicular (+pi/2), B width 2.5 (edge through verts)  -> 4.0
#   A5-B5 control, no boundary contact (A strictly inside B)       -> 3.61
op_name: "box_overlap_bev"
input {
  id: "input1"
  shape: {
    dims: 6
    dims: 7
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_FLOAT
  # A0
  value_f: 0.0
  value_f: 0.0
  value_f: 0.0
  value_f: 2.0
  value_f: 2.0
  value_f: 1.0
  value_f: 0.3
  # A1
  value_f: 0.0
  value_f: 0.0
  value_f: 0.0
  value_f: 2.0
  value_f: 2.0
  value_f: 1.0
  value_f: 0.3
  # A2
  value_f: 0.0
  value_f: 0.0
  value_f: 0.0
  value_f: 2.0
  value_f: 2.0
  value_f: 1.0
  value_f: -0.7
  # A3
  value_f: 0.0
  value_f: 0.0
  value_f: 0.0
  value_f: 2.0
  value_f: 2.0
  value_f: 1.0
  value_f: 1.5
  # A4
  value_f: 0.0
  value_f: 0.0
  value_f: 0.0
  value_f: 2.0
  value_f: 2.0
  value_f: 1.0
  value_f: 0.3
  # A5
  value_f: 0.0
  value_f: 0.0
  value_f: 0.0
  value_f: 1.9
  value_f: 1.9
  value_f: 1.0
  value_f: 0.3
}
input {
  id: "input2"
  shape: {
    dims: 6
    dims: 7
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_FLOAT
  # B0, heading 0.3
  value_f: 0.0
  value_f: 0.0
  value_f: 0.0
  value_f: 4.0
  value_f: 2.0
  value_f: 1.0
  value_f: 0.3
  # B1, heading 0.3 + pi/2
  value_f: 0.0
  value_f: 0.0
  value_f: 0.0
  value_f: 4.0
  value_f: 2.0
  value_f: 1.0
  value_f: 1.8707963268
  # B2, heading -0.7 + pi/2
  value_f: 0.0
  value_f: 0.0
  value_f: 0.0
  value_f: 4.0
  value_f: 2.0
  value_f: 1.0
  value_f: 0.8707963268
  # B3, heading 1.5 + pi/2
  value_f: 0.0
  value_f: 0.0
  value_f: 0.0
  value_f: 4.0
  value_f: 2.0
  value_f: 1.0
  value_f: 3.0707963268
  # B4, heading 0.3 + pi/2, width 2.5
  value_f: 0.0
  value_f: 0.0
  value_f: 0.0
  value_f: 2.5
  value_f: 2.0
  value_f: 1.0
  value_f: 1.8707963268
  # B5, control box, heading 0.3 + pi/2
  value_f: 0.0
  value_f: 0.0
  value_f: 0.0
  value_f: 4.4
  value_f: 2.4
  value_f: 1.0
  value_f: 1.8707963268
}
output {
  id: "output"
  shape: {
    dims: 6
    dims: 6
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_FLOAT
}
test_param: {
  error_func: DIFF1
  error_func: DIFF2
  error_threshold: 3e-3
  error_threshold: 3e-3
  baseline_device: CPU
}
